<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Message Details | Mini Messageboard</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="page-shell page-shell--narrow">
      <a class="back-link" href="/">← Back to messages</a>
      <article class="detail-card">
        <p class="eyebrow">Message details</p>
        <h1><%= messages.username %></h1>
        <p class="detail-message"><%= messages.text %></p>
        <time><%= messages.added.toLocaleString() %></time>
      </article>
    </main>
  </body>
</html>
